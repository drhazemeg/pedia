{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pedia/ui/*": ["../../packages/ui/src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "references": [
    {
      "path": "../../packages/api"
    }
  ]
}
