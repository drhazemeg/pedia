{
  "name": "pedia",
  "private": true,
  "workspaces": {
    "catalog": {
      "@commitlint/cli": "21.2.3",
      "@commitlint/config-conventional": "21.2.3",
      "@faker-js/faker": "10.6.0",
      "@orpc/client": "^1.15.5",
      "@orpc/openapi": "^1.15.5",
      "@orpc/server": "^1.15.5",
      "@orpc/zod": "^1.15.5",
      "@rolldown/plugin-babel": "0.2.4",
      "@tabler/icons-react": "3.49.0",
      "@tailwindcss/typography": "0.5.20",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/devtools-vite": "0.8.5",
      "@tanstack/react-devtools": "0.10.13",
      "@tanstack/react-form-start": "1.33.5",
      "@tanstack/react-query": "5.104.1",
      "@tanstack/react-query-devtools": "5.104.1",
      "@tanstack/react-router": "1.170.41",
      "@tanstack/react-router-devtools": "1.167.2",
      "@tanstack/react-router-ssr-query": "1.167.3",
      "@tanstack/react-start": "1.168.60",
      "@tanstack/react-table": "9.2.8",
      "@tanstack/react-table-devtools": "9.2.8",
      "@tanstack/router-cli": "1.167.40",
      "@tanstack/router-plugin": "1.168.42",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@types/bun": "^1.4.2",
      "@types/node": "26.6.5",
      "@types/pg": "^8.23.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "@vitejs/plugin-react": "6.1.2",
      "babel-plugin-react-compiler": "1.0.0",
      "better-auth": "1.7.7",
      "bumpp": "12.3.0",
      "cn": "0.4.0",
      "date-fns": "4.4.0",
      "dotenv": "18.0.7",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "eslint-plugin-fsd-lint": "1.2.1",
      "evlog": "2.30.1",
      "hono": "4.13.13",
      "jsdom": "30.1.2",
      "lucide-react": "^1.54.0",
      "next-themes": "^0.4.6",
      "nitro": "3.0.260903-beta",
      "oxfmt": "0.72.0",
      "oxlint": "1.87.0",
      "pg": "^8.23.1",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "varlock": "1.22.0",
      "zod": "^4.6.5"
    },
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "auth:generate": "cd apps/server && bun run auth:generate",
    "build": "turbo run build",
    "build:desktop": "turbo run build:stable -F desktop --",
    "build:desktop:canary": "turbo run build:canary -F desktop --",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "clean": "find . -type d \\( -name 'node_modules' -o -name 'dist' -o -name '.output' -o -name '.tanstack' -o -name '.nitro' -o -name '.vite' -o -name '.turbo' -o -name '.next' \\) -prune -exec rm -rf {} + && find . -name '*.tsbuildinfo' -delete",
    "clean:dry": "bun run --filter scripts clean:dry",
    "clean:fresh": "bun run --filter scripts clean:fresh",
    "clean:js": "find . -type f \\( -name '*.js' -o -name '*.js.map' \\) -not -path './node_modules/*' -not -path './.git/*' -delete",
    "db": "bun run --filter @pedia/db db",
    "db:fresh": " bun scripts/src/fresh.ts --force",
    "db:generate": "turbo run db:generate -F @pedia/db --",
    "db:migrate": "turbo run db:migrate -F @pedia/db --",
    "db:push": "turbo run db:push -F @pedia/db --",
    "db:seed": "bun run --filter @pedia/db db:seed",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "turbo run db:studio -F @pedia/db --",
    "db:watch": "docker compose up postgres",
    "deps": "bunx taze@latest -Ilwr --maturity-period 3",
    "deps:major": "bunx taze@latest major -Ilwr --maturity-period 3",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev:hmr -F desktop --",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "fresh": "bun run --filter scripts clean:fresh",
    "lint": "oxlint . --fix-suggestions",
    "lint:fix": "oxlint . --fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "prepare": "lefthook install",
    "ready": "bun run --filter @pedia/db ready",
    "ui": "bun run --filter @pedia/ui ui",
    "ui:web": "bun run --filter @pedia/web ui"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pedia/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
